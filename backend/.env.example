# subgrad 2.0 Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------
# App Settings
# ------------------------------------------------------------------
APP_NAME="subgrad 2.0 API"
DEBUG=false

# ------------------------------------------------------------------
# CORS — add your frontend origins (comma-separated)
# During development, localhost:3000 (React) and localhost:5173 (Vite) are pre-allowed.
# ------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------
# Gemini AI — Socratic Tutor (Phase 2)
# Get your API key from: https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
