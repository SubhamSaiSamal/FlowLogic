# subgrad frontend env — copy to .env and fill in.
# Vite only exposes vars prefixed with VITE_ to the client.

# FastAPI backend base URL (no trailing slash).
VITE_API_BASE=http://localhost:8000

# Supabase project (Settings → API in the Supabase dashboard).
# The anon key is safe to ship to the client, but rotate the one that was
# previously hardcoded in source before going public.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
